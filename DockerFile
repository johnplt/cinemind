FROM python:3.11-slim

# Installation de uv pour une gestion ultra-rapide des dépendances
COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

WORKDIR /app

# Copie des fichiers de configuration uv
COPY pyproject.toml uv.lock ./

# Installation des dépendances du projet
RUN uv sync --frozen

# Copie de l'application et des scripts
COPY . .

# Port par défaut exposé par Streamlit
EXPOSE 8501

# Commande de démarrage de Streamlit pour Railway
CMD ["sh", "-c", "uv run streamlit run app.py --server.port=${PORT:-8501} --server.address=0.0.0.0"]